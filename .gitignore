__pycache__/
*py[cod]
*$py.class

typings/

venv/
env/
.env

*.pyc

.ipynb_checkpoints/
# [FIX-L1] one directory per run (log, JSON, figures). Runs of vpp_acceleration are versioned (2026-10-26,
# to read them anywhere) without their surrogate pickles (up to 139 MB, over the GitHub limit);
# runs elsewhere stay ignored
**/runs/
!vpp_acceleration/runs/
vpp_acceleration/runs/**/*.pkl
vpp_acceleration/runs/**/test_report/
# outputs written by the scripts before the runs/ convention
mfego/*.json
mfego/*.log
mfego/*.png
mfego/*.html
example/*/*.json
example/*/*.log
example/*/*.png
example/*/*.html

# benchmark environment (requirements-benchmark.txt)
.venv-benchmark/
# MDS environment of vpp_acceleration (venv of the conda env bdToolbox, vpp_acceleration/README.md)
.venv-mds/

# XFOIL polar cache of the studies (bdFoil core content-addressed cache, safe to delete)
studies/*/results/polar_cache/
# solver work files kept by the study scripts for inspection
studies/*/results/step0_avl/
studies/*/results/*_files/
