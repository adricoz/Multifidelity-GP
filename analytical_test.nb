Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "D\[EAcute]finition", " ", "des", " ", "param\[EGrave]tres"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"cl", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"L", "=", "3"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "D\[EAcute]finition", " ", "des", " ", "fonctions", " ", 
     RowBox[{"d", "'"}], "allongement", " ", 
     RowBox[{"(", "Lambda", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"lambda1", "[", "a_", "]"}], ":=", 
     RowBox[{"2", "*", 
      RowBox[{"cl", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", "Pi", "*", "a"}], "-", "cl"}], ")"}]}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lambda2", "[", "a_", "]"}], ":=", 
     RowBox[{"8", "*", "a", "*", "Pi", "*", 
      RowBox[{"cl", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"cl", "^", "2"}]}], "+", 
         RowBox[{"4", "*", 
          RowBox[{"a", "^", "2"}], "*", 
          RowBox[{"Pi", "^", "2"}]}]}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"lambda3", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", "cl"}], "-", 
          RowBox[{"a", "*", "Pi"}]}], ")"}], "+", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"4", "*", "Pi", "*", "a", "*", "cl"}], "+", 
          RowBox[{"a", "*", 
           RowBox[{"Pi", "^", "2"}]}]}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", "a", "*", "Pi"}], "-", "cl"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "D\[EAcute]finition", " ", "des", " ", "fonctions", " ", 
     "objectifs", " ", 
     RowBox[{"(", 
      RowBox[{"Tra\[IHat]n\[EAcute]e", "+", 
       RowBox[{"P\[EAcute]nalit\[EAcute]", " ", "de", " ", "niveau"}]}], 
      ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"obj1", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{"cl", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"Pi", "*", 
        RowBox[{"lambda1", "[", "a", "]"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"obj2", "[", "a_", "]"}], ":=", 
    RowBox[{
     RowBox[{"cl", "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{"Pi", "*", 
       RowBox[{"lambda2", "[", "a", "]"}]}], ")"}]}]}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"obj3", "[", "a_", "]"}], ":=", 
     RowBox[{
      RowBox[{"cl", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"Pi", "*", 
        RowBox[{"lambda3", "[", "a", "]"}]}], ")"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Domaine", " ", "de", " ", "recherche", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
       "de", " ", "13", " ", "degr\[EAcute]s", " ", "\[AGrave]", " ", "90", " ",
         "degr\[EAcute]s"}], ",", 
       RowBox[{"en", " ", "radians"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"domaine", "=", 
    RowBox[{
     RowBox[{"0", "*", 
      RowBox[{"Pi", "/", "180"}]}], "<=", "a", "<=", 
     RowBox[{"20", " ", "*", " ", 
      RowBox[{"Pi", "/", "180"}]}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "5.", " ", "Recherche", " ", "analytique", " ", "stricte", " ", "des", " ",
      "minimums"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"min1", "=", 
     RowBox[{"Minimize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"obj1", "[", "a", "]"}], ",", "domaine"}], "}"}], ",", "a"}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"min2", "=", 
     RowBox[{"Minimize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"obj2", "[", "a", "]"}], ",", "domaine"}], "}"}], ",", "a"}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"min3", "=", 
     RowBox[{"Minimize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"obj3", "[", "a", "]"}], ",", "domaine"}], "}"}], ",", "a"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "6.", " ", "Affichage", " ", "des", " ", "r\[EAcute]sultats", " ", 
     "num\[EAcute]riques"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Minimum absolu Niveau 1: \>\"", ",", 
      RowBox[{"N", "[", "min1", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Minimum absolu Niveau 2: \>\"", ",", 
      RowBox[{"N", "[", "min2", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Minimum absolu Niveau 3: \>\"", ",", 
      RowBox[{"N", "[", "min3", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "7.", " ", "Trac\[EAcute]", " ", "des", " ", "courbes", " ", "pour", " ", 
     "visualiser", " ", 
     RowBox[{"l", "'"}], "absence", " ", "de", " ", "creux"}], "*)"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"obj1", "[", "a", "]"}], ",", 
       RowBox[{"obj2", "[", "a", "]"}], ",", 
       RowBox[{"obj3", "[", "a", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", 
       RowBox[{"13", "*", 
        RowBox[{"Pi", "/", "180"}]}], ",", 
       RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Niveau 1\>\"", ",", "\"\<Niveau 2\>\"", 
        ",", "\"\<Niveau 3\>\""}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Angle d'attaque a (radians)\>\"", 
        ",", "\"\<Valeur de l'Objectif\>\""}], "}"}]}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]], "Input",
