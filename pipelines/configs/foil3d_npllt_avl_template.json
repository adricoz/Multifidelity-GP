{
    "name": "foil3d_template",
    "description": "TEMPLATE (not runnable as is): 3D appendage optimization, level 1 = non-planar lifting line (bdFoil/NonPlanarSolver, NeuralFoil polars), level 2 = bdFoil core AVL with XFOIL polars. The planform must be produced from the design variables by a planform_writer / planform_builder function (bdGeometry CSV format: Xle, Yle, Zle, Chord, Ainc, Section...), to be provided in a dedicated module (see pipelines/README.md).",
    "kind": "foil3d",
    "parametrization": {"type": "planform", "fixed": {"section": "naca0012"}},
    "variables": [
        {"name": "span", "lower": 2.5, "upper": 4.0},
        {"name": "root_chord", "lower": 0.5, "upper": 0.9},
        {"name": "taper", "lower": 0.4, "upper": 1.0}
    ],
    "flow": {"re": 5000000.0, "alpha": [-12.0, 12.0, 2.0]},
    "levels": [
        {"solver": "npllt", "cost": 1.0,
         "options": {"profiles_folder": "C:/path/to/sections", "nodes_count": 100,
                     "polar_source": "neuralfoil", "neuralfoil_model": "xxxlarge",
                     "attitude": {"cant_deg": 0.0, "rake_deg": 2.0, "yaw_deg": 0.0}}},
        {"solver": "avl", "cost": 20.0,
         "options": {"attitude": {"cant": 0.0, "rake": 2.0, "yaw": 0.0, "sink": 0.0},
                     "settings": {"n_mesh": 40, "nspan": 100, "zsym": -1,
                                  "viscous_model": "profile"}}}
    ],
    "objective": {"type": "coefficient", "name": "Cx", "sign": -1.0},
    "optimization": {"doe": [20, 6], "iterations": 20, "seed": 0, "estimate_rho": true},
    "paths": {}
}
